<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}dd-to-signal{% endblock %}</title>
<style>{{ css }}</style>
</head>
<body>
<div class="wrap">
{% block body %}{% endblock %}
<footer>
  Generated by <a href="https://github.com/GeoCodeCrafter/dd-to-signal">dd-to-signal</a>
  from filings on SEC EDGAR. Every paragraph shown is quoted verbatim from the
  filing it came from &mdash; nothing here is summarised, generated or inferred.
  {% block footnote %}{% endblock %}
</footer>
</div>
{% block script %}{% endblock %}
</body>
</html>
